<!doctype html>
<html lang="en-GB">

<head>
    <meta charset="utf-8" />
    <title>Monopoly Probabilities - Licences</title>
    <style>
        body {
            margin: 16px;
            font-family: Arial, Helvetica, sans-serif;
            color: black;
            background-color: white;
        }

        @media (prefers-color-scheme: dark) {
            body {
                color: white;
                background-color: black;
            }

            a {
                color: #8ab4f8;
            }
        }

        pre {
            white-space: pre-wrap;
        }
    </style>
</head>

<body>
    <!-- Generated by cargo-about from about.hbs, do not edit -->
    <h1>Licences</h1>

    <p>The Monopoly Probabilities web page includes compiled code from the following Rust crates.</p>

    <h2>Overview</h2>

    <ul>
        {{#each overview}}
        <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
        {{/each}}
    </ul>

    <h2>Licence texts</h2>

    {{#each licenses}}
    <h3 id="{{id}}">{{name}}</h3>

    <p>Used by:
        {{#each used_by}}
        <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>{{#unless @last}},{{/unless}}
        {{/each}}
    </p>

    <pre>{{text}}</pre>
    {{/each}}
</body>

</html>
